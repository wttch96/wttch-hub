{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"],
      "@wttch-hub/plugin-api": ["src/types/plugin.ts"],
      "@wttch-hub/plugin-debug": ["packages/plugin-debug/src/index.ts"]
    }
  }
}
