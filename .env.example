# 文件说明：列出本地开发可选环境变量及其示例值，说明图形加速、诊断和开发沙箱等启动开关。

# Copy this file to .env when software rendering is required, for example in
# a headless, remote, or virtualised environment.
#
# Normal macOS use should leave this unset so translucent-window resizing can
# use hardware acceleration.
WTTCH_DISABLE_HARDWARE_ACCELERATION=1

# 仅限开发环境的受限虚拟机排障；正常运行无需开启，打包后忽略此开关。
WTTCH_DISABLE_SANDBOX=0
