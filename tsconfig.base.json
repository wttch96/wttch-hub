{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@module/ai": ["./src/module/ai/index.ts"],
      "@module/ai/main": ["./src/module/ai/main.ts"]
    },
    "lib": ["ES2022", "DOM"]
  }
}
