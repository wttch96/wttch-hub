{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron Main (electron-forge)",
      "type": "node",
      "request": "launch",
      // electron-forge ships wrapper scripts that run `electron-forge start`
      // with the inspector enabled, so VS Code can attach to the Electron
      // main process. Windows uses the .cmd variant, macOS/Linux the .sh.
      "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.cmd",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std"
    }
  ]
}
