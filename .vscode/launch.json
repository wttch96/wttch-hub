// 文件说明：提供 VS Code 调试启动配置，用于启动或附加 Electron 开发进程并映射源码断点。

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron Main (electron-forge)",
      "type": "node",
      "request": "launch",
      // electron-forge ships wrapper scripts that run `electron-forge start`
      // with the inspector enabled, so VS Code can attach to the Electron
      // main process. macOS/Linux use the Unix wrapper; Windows overrides it below.
      "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.sh",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/@electron-forge/cli/script/vscode.cmd"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std"
    }
  ]
}
